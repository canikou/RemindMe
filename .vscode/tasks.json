{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check (conventions)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "scripts/check-conventions.ps1"],
      "problemMatcher": []
    },
    {
      "label": "configure (debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "problemMatcher": []
    },
    {
      "label": "build (debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--parallel"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "configure (release)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "release"],
      "problemMatcher": []
    },
    {
      "label": "build (release)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release", "--parallel"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test (debug)",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "debug"],
      "dependsOn": ["check (conventions)", "build (debug)"],
      "problemMatcher": []
    },
    {
      "label": "test (release)",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "release"],
      "dependsOn": ["check (conventions)", "build (release)"],
      "problemMatcher": []
    },
    {
      "label": "format-check (debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "format-check"],
      "problemMatcher": []
    },
    {
      "label": "lint (debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "lint"],
      "problemMatcher": ["$gcc"]
    }
  ]
}
